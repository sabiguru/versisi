# Database
DATABASE_URL="postgresql://user:password@localhost:5432/versisi"

# Authentication
# Generate secure random strings for AUTH_SECRET and PORTAL_TOKEN_SECRET (both required)
# You can use: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
PORTAL_TOKEN_SECRET="your-portal-token-secret-here"
AUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"
# GITLAB_CLIENT_ID="your-gitlab-client-id"
# GITLAB_CLIENT_SECRET="your-gitlab-client-secret"

# Email Service (required for OTP and notifications)
# Using Resend (recommended)
RESEND_API_KEY="your-resend-api-key"

# Or using SMTP
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="noreply@example.com"
